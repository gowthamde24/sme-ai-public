{
  "template": {
    "id": "silk-wholesale",
    "template_version": 1,
    "schema_version": 1,
    "engine": "icp-rules",
    "purpose": "Starting point for a silk-saree wholesaler's ICP. Generic structure only: no customer data, no price list.",
    "verification": "unverified",
    "source": "owner placeholder, not yet confirmed by the family",
    "contains_real_customer_data": false,
    "contains_prices": false,
    "how_it_is_used": "Published as version 1 of a tenant's ICP profile through the API; the tenant then publishes its own versions. The family's answers replace the placeholders as tenant data, never here."
  },
  "human_labels_override_score": true,
  "factors": [
    {
      "id": "silk_saree_fit",
      "label": "Silk / saree product fit",
      "max_points": 25,
      "verification": "unverified",
      "rule": {
        "type": "keyword_fit",
        "fields": [
          "industry",
          "tags",
          "name"
        ],
        "strong_vocabulary": "silk_saree_strong",
        "weak_vocabulary": "textile_weak",
        "points_percent": {
          "strong_in_industry_or_tags": 100,
          "strong_in_name_only": 70,
          "weak_only": 35,
          "none": 0
        }
      }
    },
    {
      "id": "buyer_type_fit",
      "label": "Buyer type",
      "max_points": 20,
      "verification": "unverified",
      "rule": {
        "type": "attribute_fraction",
        "attribute": "buyer_type",
        "when_missing": "unknown"
      }
    },
    {
      "id": "geography_fit",
      "label": "Geography",
      "max_points": 20,
      "verification": "unverified",
      "rule": {
        "type": "place_tier",
        "fields": [
          "city",
          "region"
        ],
        "tiers": "geography",
        "when_missing": "unknown",
        "when_not_listed": "unknown"
      }
    },
    {
      "id": "business_scale",
      "label": "Can take 5 or more mid / premium silk pieces per order",
      "max_points": 15,
      "verification": "unverified",
      "rule": {
        "type": "attribute_max",
        "attributes": [
          "order_scale",
          "size_band"
        ],
        "when_missing": "unknown"
      }
    },
    {
      "id": "reachability",
      "label": "Contact reachability",
      "max_points": 10,
      "verification": "unverified",
      "rule": {
        "type": "contact_quality",
        "email_points": 4,
        "phone_points": 3,
        "decision_maker_points": 3,
        "decision_maker_vocabulary": "decision_maker_titles",
        "suppressed_or_bounced_points": 0
      }
    },
    {
      "id": "evidence_quality",
      "label": "Evidence attached",
      "max_points": 10,
      "verification": "unverified",
      "rule": {
        "type": "evidence_count",
        "any_points": 4,
        "two_or_more_points": 3,
        "two_or_more_kinds_points": 3
      }
    }
  ],
