#!/usr/bin/env sh
# `scripts/sb <supabase args>`: the Supabase CLI against the right local stack (job BG, docs/runbooks/two-local-stacks.md).
#   SME_STACK=agent (the default) -> stacks/sme-ai-agent (project sme-ai-agent, ports 544xx); its migrations/tests are re-copied from supabase/ first.
#   SME_STACK=owner               -> the repository's supabase/ (project sme-ai, ports 543xx).
# On the OWNER's stack the actions that destroy or disturb its data (`db reset`, `stop`, `test db`, `db push`, `db pull`) are refused unless OWNER_OK=1.
set -eu
here="$(cd "$(dirname "$0")" && pwd)"
root="$(cd "$here/.." && pwd)"
. "$here/stack.sh"
case "$*" in
  "db reset"* | "stop"* | "test db"* | "db push"* | "db pull"*) sme_require_owner_ok "run 'supabase $*'" || exit 3 ;;
esac
cd "$root"
if [ "$SME_STACK" = agent ]; then
  # the folder's copies of the migrations and tests are needed only by the commands that read them (a status call, made by every app start, needs none)
  case "$*" in
    "start"* | "db "* | "test "* | "migration "* | "link"* | "gen "*) python3 "$here/gen_agent_stack.py" --sync ;;
    *) python3 "$here/gen_agent_stack.py" --ensure ;;
  esac
  exec supabase "$@" --workdir "$root/$SME_WORKDIR"
fi
exec supabase "$@"
