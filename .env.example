# Names only. Never commit real values. Copy to .env locally.

# --- Web (public, safe for browser) ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
# Added in T002:
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- API (server-side only) ---
API_ENV=development
API_CORS_ORIGINS=http://localhost:3000
# Added in T002 (server-side only). T002 deliberately has NO service-role key: the API acts only
# with the user's own JWT so RLS always applies. Ask before adding one in a later ticket.
# Local stack: run `supabase start`; defaults below are filled in automatically when
# API_ENV=development (SUPABASE_ANON_KEY is the only one you must set; it is a public key).
# Outside development the API REFUSES TO START unless every one of these is set (https only).
# SUPABASE_URL=https://<project>.supabase.co
# SUPABASE_ANON_KEY=<publishable/anon key>
# SUPABASE_JWT_ISSUER=https://<project>.supabase.co/auth/v1
# SUPABASE_JWT_AUDIENCE=authenticated
# SUPABASE_JWKS_URL=https://<project>.supabase.co/auth/v1/.well-known/jwks.json
# SUPABASE_JWT_ALGORITHMS=ES256
# Legacy HS256 projects only (also add HS256 to SUPABASE_JWT_ALGORITHMS):
# SUPABASE_JWT_SECRET=
# Added in T006:
# LLM_PROVIDER=
# LLM_API_KEY=
