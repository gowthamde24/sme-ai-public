# Names only. Never commit real values. Copy to .env locally.

# --- Web (public, safe for browser) ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
# The ONLY Supabase values the browser/web app may know: project URL + the publishable key (formerly
# "anon"). Local stack: `supabase status` prints them; do not commit real values.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=   # legacy name, still accepted (the publishable name wins when both are set)

# --- API (server-side only) ---
API_ENV=development
API_CORS_ORIGINS=http://localhost:3000
# Added in T002 (server-side only). T002 deliberately has NO service-role key: the API acts only
# with the user's own JWT so RLS always applies. Ask before adding one in a later ticket.
# Local stack: run `supabase start`; defaults below are filled in automatically when
# API_ENV=development (the publishable key is the only one you must set; it is a public key).
# Outside development the API REFUSES TO START unless every one of these is set (https only).
# SUPABASE_URL=https://<project>.supabase.co
# SUPABASE_PUBLISHABLE_KEY=<publishable key>
# SUPABASE_ANON_KEY=<legacy name of the same public key; still accepted, the publishable name wins>
# There is NO variable for a secret / service-role key and none is added (ADR 0017 c).
# SUPABASE_JWT_ISSUER=https://<project>.supabase.co/auth/v1
# SUPABASE_JWT_AUDIENCE=authenticated
# SUPABASE_JWKS_URL=https://<project>.supabase.co/auth/v1/.well-known/jwks.json
# SUPABASE_JWT_ALGORITHMS=ES256
# Legacy HS256 projects only (also add HS256 to SUPABASE_JWT_ALGORITHMS):
# SUPABASE_JWT_SECRET=
# Added in T006:
# LLM_PROVIDER=

# Agents (T006). OFF by default. The platform and per-workspace switches are in the database (operator-managed).
# AGENTS_ENABLED=false
# LLM_PROVIDER=fake   # a scripted model for development ONLY; refused when API_ENV is not "development"
# AGENTS_MAX_WORKERS=2
# AGENTS_MAX_QUEUE=8
# The real model adapter (provider "anthropic") stays OFF until ALL of these are set. The key is a secret: environment only.
# LLM_PROVIDER=anthropic
# LLM_MODEL=<model id of your choice; there is no default>
# ANTHROPIC_API_KEY=<a dedicated key with a hard monthly spend cap set at the provider>
# LLM_INPUT_MICROS_PER_MTOK=<price per million input tokens, in millionths of the billing currency>
# LLM_OUTPUT_MICROS_PER_MTOK=<price per million output tokens, same unit>
# LLM_SPEND_CAP_CONFIRMED=false   # set to true only after the provider-side hard cap exists
