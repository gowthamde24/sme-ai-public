              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Handoff Reminder Minutes"
        },
        "call_paise_per_minute": {
          "anyOf": [
            {
              "maximum": 5000,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Call Paise Per Minute"
        }
      },
      "title": "PolicyIn",
      "type": "object"
    },
    "PolicyOut": {
