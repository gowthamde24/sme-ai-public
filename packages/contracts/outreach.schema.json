    "OutcomeResultIn": {
      "additionalProperties": false,
      "properties": {
        "outcome": {
          "enum": [
            "positive",
            "negative",
            "unclear"
          ],
          "title": "Outcome",
          "type": "string"
        },
        "category": {
          "anyOf": [
            {
              "enum": [
                "interested",
                "visit_booked",
                "order_likely",
                "not_interested",
                "wrong_number",
                "too_costly",
                "already_bought",
                "call_back_later"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Category"
        },
        "reason": {
          "anyOf": [
            {
              "maxLength": 200,
              "minLength": 2,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason"
        },
        "callback_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Callback At"
        },
        "captured": {
          "anyOf": [
            {
              "patternProperties": {
                "^[a-z][a-z0-9_]{0,31}$": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "integer"
                    },
                    {
                      "type": "number"
                    },
                    {
                      "type": "boolean"
                    }
                  ]
                }
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Captured"
        }
      },
      "required": [
        "outcome"
      ],
      "title": "OutcomeResultIn",
      "type": "object"
    },
