{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "outreach.schema.json",
  "title": "Speed to lead and approve once (job DR A3)",
  "description": "Generated from services/ai-api/app/outreach/models.py by `make contracts`.",
  "$defs": {
    "ApproveIn": {
      "additionalProperties": false,
      "properties": {
        "plan_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Plan Sha256",
          "type": "string"
        }
      },
      "required": [
        "plan_sha256"
      ],
      "title": "ApproveIn",
      "type": "object"
    },
    "BatchAnswer": {
      "properties": {
        "batch": {
          "$ref": "#/$defs/BatchOut"
        },
        "plan": {
          "$ref": "#/$defs/PlanOut"
        },
        "progress": {
          "anyOf": [
            {
              "$ref": "#/$defs/ProgressOut"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "batch",
        "plan"
      ],
      "title": "BatchAnswer",
      "type": "object"
    },
    "BatchIn": {
      "additionalProperties": false,
      "properties": {
        "batch_id": {
          "format": "uuid",
          "title": "Batch Id",
          "type": "string"
        },
        "name": {
          "maxLength": 80,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "goal": {
          "enum": [
            "site_visit",
            "counselling",
            "appointment",
            "qualify",
            "test_drive",
            "site_measurement",
            "quote",
            "trial",
            "callback",
            "general"
          ],
          "title": "Goal",
          "type": "string"
        },
        "channel": {
          "enum": [
            "call",
            "whatsapp",
            "both"
          ],
          "title": "Channel",
          "type": "string"
        },
        "language": {
          "enum": [
            "en",
            "te",
            "hi",
            "kn",
            "ta",
            "ml"
          ],
          "title": "Language",
          "type": "string"
        },
        "who": {
          "anyOf": [
            {
              "$ref": "#/$defs/WhoContacts"
            },
            {
              "$ref": "#/$defs/WhoLeads"
            },
            {
              "$ref": "#/$defs/WhoSource"
            }
          ],
          "title": "Who"
        },
        "questions": {
          "items": {
            "maxLength": 160,
            "minLength": 2,
            "type": "string"
          },
          "maxItems": 8,
          "title": "Questions",
          "type": "array"
        },
        "message_text": {
          "anyOf": [
            {
              "maxLength": 600,
              "minLength": 2,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Message Text"
        },
        "window_days": {
          "default": 7,
          "maximum": 14,
          "minimum": 1,
          "title": "Window Days",
          "type": "integer"
        },
        "max_calls_per_day": {
          "anyOf": [
            {
              "maximum": 5000,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Calls Per Day"
        },
        "max_total_minutes": {
          "anyOf": [
            {
              "maximum": 100000,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Total Minutes"
        }
      },
      "required": [
        "batch_id",
        "name",
        "goal",
        "channel",
        "language",
        "who"
      ],
      "title": "BatchIn",
      "type": "object"
    },
    "BatchOut": {
      "properties": {
        "id": {
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "status": {
          "enum": [
            "planned",
            "running",
            "paused",
            "done",
            "cancelled"
          ],
          "title": "Status",
          "type": "string"
        },
        "paused_reason": {
          "anyOf": [
            {
              "enum": [
                "owner",
                "cap_calls",
                "cap_minutes",
                "billing"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Paused Reason"
        },
        "goal": {
          "enum": [
            "site_visit",
            "counselling",
            "appointment",
            "qualify",
            "test_drive",
            "site_measurement",
            "quote",
            "trial",
            "callback",
            "general"
          ],
          "title": "Goal",
          "type": "string"
        },
        "channel": {
          "enum": [
            "call",
            "whatsapp",
            "both"
          ],
          "title": "Channel",
          "type": "string"
        },
        "language": {
          "enum": [
            "en",
            "te",
            "hi",
            "kn",
            "ta",
            "ml"
          ],
          "title": "Language",
          "type": "string"
        },
        "questions": {
          "items": {
            "type": "string"
          },
          "title": "Questions",
          "type": "array"
        },
        "message_text": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Message Text"
        },
        "window_days": {
          "title": "Window Days",
          "type": "integer"
        },
        "max_calls_per_day": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Max Calls Per Day"
        },
        "max_total_minutes": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Max Total Minutes"
        },
        "plan_sha256": {
          "title": "Plan Sha256",
          "type": "string"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "approved_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Approved At"
        },
        "finished_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Finished At"
        }
      },
      "required": [
        "id",
        "name",
        "status",
        "paused_reason",
        "goal",
        "channel",
        "language",
        "questions",
        "message_text",
        "window_days",
        "max_calls_per_day",
        "max_total_minutes",
        "plan_sha256",
        "created_at",
        "approved_at",
        "finished_at"
      ],
      "title": "BatchOut",
      "type": "object"
    },
    "CapsIn": {
      "additionalProperties": false,
      "properties": {
        "max_calls_per_day": {
          "anyOf": [
            {
              "maximum": 5000,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Calls Per Day"
        },
        "max_total_minutes": {
          "anyOf": [
            {
              "maximum": 100000,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Total Minutes"
        }
      },
      "title": "CapsIn",
      "type": "object"
    },
    "ExcludeIn": {
      "additionalProperties": false,
      "properties": {
        "contact_ids": {
          "items": {
            "format": "uuid",
            "type": "string"
          },
          "maxItems": 2000,
          "minItems": 1,
          "title": "Contact Ids",
          "type": "array"
        }
      },
      "required": [
        "contact_ids"
      ],
      "title": "ExcludeIn",
      "type": "object"
    },
    "HandoffOut": {
      "properties": {
        "id": {
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "lead_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Lead Id"
        },
        "contact_id": {
          "format": "uuid",
          "title": "Contact Id",
          "type": "string"
        },
        "contact_name": {
          "title": "Contact Name",
          "type": "string"
        },
        "summary": {
          "title": "Summary",
          "type": "string"
        },
        "assigned_to": {
          "format": "uuid",
          "title": "Assigned To",
          "type": "string"
        },
        "notified_at": {
          "format": "date-time",
          "title": "Notified At",
          "type": "string"
        },
        "reminder_sent_at": {
