              "type": "null"
            }
          ],
          "title": "Reminder Sent At"
        },
        "acted_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Acted At"
        }
      },
      "required": [
        "id",
        "lead_id",
        "contact_id",
        "contact_name",
        "summary",
        "assigned_to",
        "notified_at",
        "reminder_sent_at",
        "acted_at"
      ],
      "title": "HandoffOut",
      "type": "object"
    },
    "HoursOut": {
      "properties": {
        "days": {
          "items": {
            "type": "integer"
          },
          "title": "Days",
          "type": "array"
        },
        "from_minute": {
          "title": "From Minute",
          "type": "integer"
        },
        "to_minute": {
          "title": "To Minute",
          "type": "integer"
        },
        "from": {
          "enum": [
            "assistant",
            "call_settings",
            "default"
          ],
          "title": "From",
          "type": "string"
        }
      },
      "required": [
        "days",
        "from_minute",
        "to_minute",
        "from"
      ],
      "title": "HoursOut",
      "type": "object"
    },
    "ItemOut": {
      "properties": {
        "id": {
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "contact_id": {
          "format": "uuid",
          "title": "Contact Id",
          "type": "string"
        },
        "lead_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Lead Id"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "status": {
          "enum": [
            "planned",
            "waiting",
            "done",
            "stopped",
            "skipped"
          ],
          "title": "Status",
          "type": "string"
        },
        "reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Reason"
        },
        "attempts": {
          "title": "Attempts",
          "type": "integer"
        },
        "next_action": {
          "anyOf": [
            {
              "enum": [
                "call",
                "whatsapp"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Next Action"
        },
        "next_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Next At"
        },
        "last_result": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Last Result"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        }
      },
      "required": [
        "id",
        "contact_id",
        "lead_id",
        "name",
        "status",
        "reason",
        "attempts",
        "next_action",
        "next_at",
        "last_result",
        "created_at"
      ],
      "title": "ItemOut",
      "type": "object"
    },
    "ItemsOut": {
      "properties": {
        "items": {
          "items": {
            "$ref": "#/$defs/ItemOut"
          },
          "title": "Items",
          "type": "array"
        },
        "next_cursor": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Next Cursor"
        }
      },
      "required": [
        "items",
        "next_cursor"
      ],
