{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "billing.schema.json",
  "title": "Plans and billing: the catalogue, usage meters, the trial (job DI)",
  "description": "Generated from services/ai-api/app/billing/models.py by `make contracts`.",
  "$defs": {
    "AccessOut": {
      "additionalProperties": false,
      "description": "Whether the workspace can be changed. `access` is `read_only` after the trial (or the paid period) ended unpaid: signing in, viewing and exporting stay; sending, AI, calls and every change stop,\nso the web shows view and export only and switches the edit buttons off. Always `full` while the platform's billing switch is off. The data is kept until `delete_on` (90 days after\n`read_only_since`).",
      "properties": {
        "access": {
          "enum": [
            "full",
            "read_only"
          ],
          "title": "Access",
          "type": "string"
        },
        "read_only_since": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Read Only Since"
        },
        "delete_on": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Delete On"
        },
        "data_days_left": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Data Days Left"
        },
        "can_resume": {
          "title": "Can Resume",
          "type": "boolean"
        },
        "sending": {
          "enum": [
            "on",
            "off"
          ],
          "title": "Sending",
          "type": "string"
        },
        "waiting_for": {
          "anyOf": [
            {
              "const": "whatsapp",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Waiting For"
        },
        "erasure_warning_sent_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Erasure Warning Sent At"
        },
        "demo": {
          "default": false,
          "title": "Demo",
          "type": "boolean"
        },
        "exempt": {
          "default": false,
          "title": "Exempt",
          "type": "boolean"
        }
      },
      "required": [
        "access",
        "read_only_since",
        "delete_on",
        "data_days_left",
        "can_resume",
        "sending",
        "waiting_for"
      ],
      "title": "AccessOut",
      "type": "object"
    },
    "BalanceKindOut": {
      "additionalProperties": false,
