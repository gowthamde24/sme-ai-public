          "type": "string"
        },
        "included": {
          "title": "Included",
          "type": "boolean"
        },
        "topup": {
          "title": "Topup",
          "type": "integer"
        },
        "plan_allowance": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
