        "topup_balance": {
          "default": 0.0,
          "title": "Topup Balance",
          "type": "number"
        },
        "next_topup_expiry": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Next Topup Expiry"
        },
        "projected_run_out_on": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Projected Run Out On"
        },
        "runs_out_before_period_end": {
          "default": false,
          "title": "Runs Out Before Period End",
          "type": "boolean"
        },
        "blocked": {
          "default": false,
          "title": "Blocked",
          "type": "boolean"
        },
        "overage": {
          "anyOf": [
            {
              "$ref": "#/$defs/OverageOut"
