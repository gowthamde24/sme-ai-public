            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Whatsapp Connected At"
        },
        "access": {
          "enum": [
            "full",
            "read_only"
          ],
          "title": "Access",
          "type": "string"
        },
        "read_only_since": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Read Only Since"
        },
        "delete_on": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Delete On"
        },
        "data_days_left": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Data Days Left"
        }
      },
      "required": [
        "plan",
        "subscription",
        "period",
        "usage",
        "notices",
        "can_start_trial",
        "can_resume",
        "whatsapp_connected_at",
        "access",
        "read_only_since",
        "delete_on",
        "data_days_left"
      ],
      "title": "BillingOut",
      "type": "object"
    },
    "BuyerOut": {
