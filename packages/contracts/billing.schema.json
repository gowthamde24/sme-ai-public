          ],
          "title": "Period Start"
        },
        "taxable_paise": {
          "title": "Taxable Paise",
          "type": "integer"
        },
        "gst_rate_bp": {
          "title": "Gst Rate Bp",
          "type": "integer"
        },
        "cgst_paise": {
          "title": "Cgst Paise",
          "type": "integer"
        },
        "sgst_paise": {
          "title": "Sgst Paise",
          "type": "integer"
        },
        "igst_paise": {
          "title": "Igst Paise",
          "type": "integer"
        },
        "total_paise": {
          "title": "Total Paise",
          "type": "integer"
        },
        "seller": {
          "$ref": "#/$defs/SellerOut"
        },
        "buyer": {
          "$ref": "#/$defs/BuyerOut"
        },
        "fake": {
          "title": "Fake",
          "type": "boolean"
        },
        "payment_status": {
          "const": "paid_fake",
          "title": "Payment Status",
          "type": "string"
        }
      },
      "required": [
        "id",
        "number",
        "kind",
        "description",
        "issued_at",
        "period_start",
        "taxable_paise",
        "gst_rate_bp",
        "cgst_paise",
        "sgst_paise",
        "igst_paise",
        "total_paise",
        "seller",
        "buyer",
        "fake",
        "payment_status"
      ],
