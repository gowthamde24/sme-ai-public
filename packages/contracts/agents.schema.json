{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agents.schema.json",
  "title": "Agent run API contracts (T006)",
  "description": "Generated from services/ai-api/app/agent_runs/models.py by `make contracts`. An agent claim is a SUGGESTION until a human accepts it: show it as 'agent suggestion, unreviewed'. Claim values are UNTRUSTED text: show them as plain text. Requests forbid unknown properties: a tenant, an origin, a confidence of the agent's own or a provider can never be sent.",
  "$defs": {
    "AddFieldIn": {
      "additionalProperties": false,
      "description": "A human adds a field the extraction missed. `line` (1-5) for saree_type, fabric, colour and quantity; none for the others.\n`quote`, if given, must be words of the stored enquiry text.",
      "properties": {
        "line": {
          "anyOf": [
            {
              "maximum": 5,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Line"
        },
        "field": {
          "enum": [
            "saree_type",
            "fabric",
            "colour",
            "quantity",
            "budget",
            "deadline",
            "delivery_city",
            "payment_terms"
          ],
          "title": "Field",
          "type": "string"
        },
        "value": {
          "maxLength": 120,
          "minLength": 1,
          "title": "Value",
          "type": "string"
        },
        "quote": {
          "anyOf": [
            {
              "maxLength": 300,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Quote"
        }
      },
      "required": [
        "field",
        "value"
      ],
      "title": "AddFieldIn",
      "type": "object"
    },
    "AgentCostOut": {
      "additionalProperties": false,
      "description": "Today's (Indian day) agent spending of a workspace, for its Owner / Admin.\n\nAmounts are millionths of the billing currency. `open_micros` is counted at the worst\ncase, not at what was spent.",
      "properties": {
        "day": {
          "format": "date",
          "title": "Day",
          "type": "string"
        },
        "cap_micros": {
          "title": "Cap Micros",
          "type": "integer"
        },
        "settled_micros": {
          "title": "Settled Micros",
          "type": "integer"
        },
        "open_micros": {
          "title": "Open Micros",
          "type": "integer"
        },
        "open": {
          "items": {
            "$ref": "#/$defs/OpenReservationOut"
          },
          "title": "Open",
          "type": "array"
        }
      },
      "required": [
        "day",
        "cap_micros",
        "settled_micros",
        "open_micros",
        "open"
      ],
      "title": "AgentCostOut",
      "type": "object"
    },
    "AgentSettingsIn": {
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "title": "Enabled",
          "type": "boolean"
        }
      },
      "required": [
        "enabled"
      ],
      "title": "AgentSettingsIn",
      "type": "object"
    },
    "AgentSettingsOut": {
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "title": "Enabled",
          "type": "boolean"
        }
      },
      "required": [
        "enabled"
      ],
      "title": "AgentSettingsOut",
      "type": "object"
    },
    "CancelOut": {
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": [
            "running",
            "succeeded",
            "failed",
            "cancelled",
            "expired",
            "killed"
          ],
          "title": "Status",
          "type": "string"
        },
        "replayed": {
          "title": "Replayed",
          "type": "boolean"
        }
      },
      "required": [
        "status",
        "replayed"
      ],
      "title": "CancelOut",
      "type": "object"
    },
    "CaptureIn": {
      "additionalProperties": false,
      "description": "Paste an enquiry onto a lead. The id is chosen by the caller (idempotent create). `text` and `subject` are what the person\npasted: the API strips invisible characters and scrubs e-mail addresses and Indian mobile numbers BEFORE storing, and the\noriginal is kept nowhere (owner decision 1).",
      "properties": {
        "id": {
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "channel": {
          "enum": [
            "email",
            "whatsapp",
            "form",
            "other"
          ],
          "title": "Channel",
          "type": "string"
        },
        "received_at": {
          "format": "date-time",
          "title": "Received At",
          "type": "string"
        },
        "subject": {
          "anyOf": [
            {
              "maxLength": 2000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Subject"
        },
        "text": {
          "maxLength": 200000,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "id",
        "channel",
        "received_at",
        "text"
      ],
      "title": "CaptureIn",
      "type": "object"
    },
    "CaptureOut": {
      "additionalProperties": false,
      "description": "What was stored, and whether it differs from what was pasted (so the person sees what changed).",
      "properties": {
        "enquiry": {
          "$ref": "#/$defs/EnquiryOut"
        },
        "text_changed": {
          "title": "Text Changed",
          "type": "boolean"
        },
        "truncated": {
          "title": "Truncated",
          "type": "boolean"
        }
      },
      "required": [
        "enquiry",
        "text_changed",
        "truncated"
      ],
      "title": "CaptureOut",
      "type": "object"
    },
    "ClaimEvidenceOut": {
      "additionalProperties": false,
      "description": "What a suggestion rests on, for a reviewer. Everything here is UNTRUSTED text (a model chose\nthe quote from a page a stranger controls): clients render it as plain text. No link is\noffered: the source is a host and a path, shown as text.\n\nThe runtime checked that the quote appears in the page it names; the DATABASE did not (it\nnever sees the page): a client says so next to the quote.",
      "properties": {
        "kind": {
          "title": "Kind",
          "type": "string"
        },
        "stance": {
          "enum": [
            "supports",
            "context",
            "contradicts"
          ],
          "title": "Stance",
          "type": "string"
        },
        "provider": {
          "title": "Provider",
          "type": "string"
        },
        "host": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Host"
        },
        "path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Path"
        },
        "quote": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Quote"
        }
      },
      "required": [
        "kind",
        "stance",
        "provider",
        "host",
        "path",
        "quote"
      ],
      "title": "ClaimEvidenceOut",
      "type": "object"
    },
