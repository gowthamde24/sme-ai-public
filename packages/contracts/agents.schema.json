            "$ref": "#/$defs/ClaimEvidenceOut"
          },
          "title": "Evidence",
          "type": "array"
        }
      },
      "required": [
        "id",
        "company_id",
        "lead_id",
        "predicate",
        "value",
        "confidence",
        "claim_confidence",
        "created_via",
        "agent_run_id",
        "created_by",
        "created_at",
        "review_state",
        "review_confidence",
        "reviewed_by",
        "reviewed_at"
      ],
      "title": "ClaimSuggestionOut",
      "type": "object"
    },
    "DecisionIn": {
      "additionalProperties": false,
