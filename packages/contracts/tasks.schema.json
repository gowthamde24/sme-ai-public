          "type": "string"
        },
        "cap_paise": {
          "anyOf": [
            {
              "maximum": 10000000,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cap Paise"
        }
      },
      "required": [
        "plan_sha256"
      ],
      "title": "ApproveIn",
      "type": "object"
    },
    "CapIn": {
      "additionalProperties": false,
      "properties": {
