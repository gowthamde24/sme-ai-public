    "LeadLabelCreate": {
      "additionalProperties": false,
      "description": "`id` is generated by the client, once per submit attempt (like every other create): the same\nid with the same payload is a retry (200 with the stored label), anything else under a used id\nis a 409.",
      "properties": {
        "id": {
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "label": {
          "$ref": "#/$defs/LeadLabel"
