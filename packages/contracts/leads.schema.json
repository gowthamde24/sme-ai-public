        "id": {
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "tenant_id": {
          "format": "uuid",
          "title": "Tenant Id",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/ExportKind"
        },
        "format": {
          "$ref": "#/$defs/ExportFormat"
        },
        "row_count": {
          "title": "Row Count",
          "type": "integer"
        },
        "content_sha256": {
          "title": "Content Sha256",
          "type": "string"
        },
        "created_by": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Created By"
        },
        "created_via": {
          "$ref": "#/$defs/RecordOrigin"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        }
      },
      "required": [
        "id",
        "tenant_id",
        "kind",
        "format",
        "row_count",
        "content_sha256",
        "created_by",
        "created_via",
        "created_at"
      ],
      "title": "ExportRecordOut",
      "type": "object"
    },
    "ExportRequest": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "$ref": "#/$defs/ExportKind",
          "default": "lead_labels"
        },
        "format": {
          "$ref": "#/$defs/ExportFormat",
          "default": "csv"
        }
      },
      "title": "ExportRequest",
      "type": "object"
