{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "festivals.schema.json",
  "title": "The dated festival calendar of the Jobs screens (jobs contract 1.1, T8)",
  "description": "packages/packs/festivals.json: one row per region, season and year, the date written out. Loaded by services/ai-api/app/jobs/festivals.py (fails closed); checked by tests/test_jobs_festivals.py.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "status",
    "version",
    "rows"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "$comment": {
      "type": "string"
    },
    "status": {
      "const": "draft"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "rows": {
      "type": "array",
      "minItems": 1,
      "maxItems": 400,
      "items": {
        "$ref": "#/$defs/row"
      }
    }
  },
  "$defs": {
    "row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "region",
        "season",
        "name",
        "date"
      ],
      "properties": {
        "region": {
          "enum": [
            "andhra",
            "telangana",
            "karnataka",
            "india"
          ]
        },
        "season": {
          "enum": [
            "diwali",
            "wedding_season",
            "new_year"
          ]
        },
        "name": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "en",
            "te"
          ],
          "properties": {
            "en": {
              "type": "string",
              "minLength": 1,
              "maxLength": 60
            },
            "te": {
              "type": "string",
              "minLength": 1,
              "maxLength": 60
            },
            "hi": {
              "type": "string",
              "minLength": 1,
              "maxLength": 60
            },
            "kn": {
              "type": "string",
              "minLength": 1,
              "maxLength": 60
            }
          }
        },
        "date": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        }
      }
    }
  }
}
