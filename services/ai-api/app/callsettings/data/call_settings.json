  "status": "draft: the numbers are sensible starting points, to be tuned with real calls; labels await native review",
  "note": "Defaults per business type (the pack code). The first key is the default for a code that is not listed. The numbers are data, not code. A school never makes sales calls and never calls about dues or fees.",
  "locked": {
    "education": {
      "allowed_purposes": [
        "admission_followup",
        "visit_reminder",
        "event_reminder"
      ]
    }
  },
  "options": {
    "voicemail_actions": [
      {
        "id": "hang_up",
        "label": "Hang up",
        "description": "End the call and count it as no answer."
      },
      {
        "id": "leave_message",
        "label": "Leave a short message",
        "description": "Say who is calling and that you will try again. Never says prices or amounts."
      },
      {
        "id": "retry_later",
        "label": "Try again later",
        "description": "Hang up and call again by the 'no answer' rule."
      }
    ],
    "phone_menu_actions": [
      {
        "id": "hang_up",
        "label": "Hang up",
        "description": "A phone menu ('press 1 for...') is not a person."
      },
      {
        "id": "retry_later",
        "label": "Try again later",
        "description": "Hang up and call again by the 'no answer' rule."
      }
    ],
    "sensitivities": [
      {
        "id": "low",
        "label": "Low",
        "description": "Finishes its sentence unless the customer keeps talking."
      },
      {
        "id": "medium",
        "label": "Medium",
        "description": "Stops when the customer clearly starts to speak."
      },
      {
        "id": "high",
        "label": "High",
        "description": "Stops at the first sound; best for quick, impatient callers."
      }
    ],
    "topics": [
      {
        "id": "pricing",
        "label": "Price talks"
      },
      {
        "id": "payment",
        "label": "Payment and dues"
