    {
      "name": "Create a campaign: a list of consented contacts and a job (idempotent)",
      "request": {
        "body": {
          "mode": "raw",
          "options": {
            "raw": {
              "language": "json"
            }
          },
          "raw": "{\n  \"contacts\": [\n    {\n      \"consent\": {\n        \"given\": true,\n        \"text\": \"I agree to be called\"\n      },\n      \"name\": \"Ravi Kumar\",\n      \"phone\": \"+919800000001\",\n      \"source\": \"website\"\n    }\n  ],\n  \"job\": {\n    \"goal\": \"Ask if they still want the saree catalogue.\",\n    \"name\": \"Follow up\"\n  },\n  \"language\": \"te\",\n  \"name\": \"Diwali enquiries\"\n}"
        },
        "description": "Needs: campaigns:write. Send an `Idempotency-Key` header (1 to 100 characters); the same key with the same body returns the first answer (200, `Idempotent-Replayed: true`).",
        "header": [
          {
            "key": "Authorization",
            "type": "text",
            "value": "Bearer {{api_key}}"
          },
          {
            "key": "Idempotency-Key",
