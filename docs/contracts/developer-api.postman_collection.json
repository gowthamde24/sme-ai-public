{
  "info": {
    "description": "The Stack19 developer API. TEST MODE only: keys start with `sk_test_`, every call is simulated, nothing is dialled or sent, and every answer carries `Stack19-Mode: test`. Send `Authorization: Bearer sk_test_...`. 60 requests a minute per key (`X-RateLimit-Limit`, `X-RateLimit-Remaining`, `Retry-After` on 429). Every refusal has the one body `{error: {code, message, retry_after, request_id}}`; the codes are listed in docs/contracts/error-codes.md. Contract: docs/contracts/developer-api.md.",
    "name": "Stack19 developer API (test mode)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Create a lead (idempotent)",
      "request": {
        "body": {
          "mode": "raw",
          "options": {
            "raw": {
              "language": "json"
            }
          },
          "raw": "{\n  \"consent\": {\n    \"at\": \"2026-11-24T10:00:00Z\",\n    \"given\": true,\n    \"text\": \"I agree to be called\"\n  },\n  \"custom_fields\": {\n    \"budget\": \"50000\"\n  },\n  \"language\": \"te\",\n  \"name\": \"Ravi Kumar\",\n  \"notes\": \"Wants 40 sarees for a wedding\",\n  \"phone\": \"+919800000001\",\n  \"source\": \"website\"\n}"
        },
        "description": "Needs: leads:write. Send an `Idempotency-Key` header (1 to 100 characters); the same key with the same body returns the first answer (200, `Idempotent-Replayed: true`).",
        "header": [
          {
            "key": "Authorization",
            "type": "text",
            "value": "Bearer {{api_key}}"
          },
          {
            "key": "Idempotency-Key",
            "type": "text",
            "value": "{{$guid}}"
          },
          {
            "key": "Content-Type",
            "type": "text",
            "value": "application/json"
          }
        ],
        "method": "POST",
        "url": {
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "v1",
            "leads"
          ],
          "query": [],
          "raw": "{{base_url}}/api/v1/leads",
          "variable": []
        }
      }
    },
    {
      "name": "List leads, oldest change first",
      "request": {
        "description": "Needs: leads:read.",
