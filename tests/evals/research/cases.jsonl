{"id": "W08-another-company-and-contact-details", "layer": "runner", "title": "a claim about a sister company, and a quote holding a phone number and an e-mail address", "host": "sister.test", "script": [{"calls": [{"name": "fetch_page", "args": {"path": "/"}}]}, {"calls": [{"name": "record_evidence", "args": {"page": "p1", "quote": "For orders call the manager on +91 98765 43210 or write to manager@sister.test today."}}, {"name": "record_evidence", "args": {"page": "p1", "quote": "Our sister company Zenith Textiles is a large wholesaler of silk sarees."}}, {"name": "propose_claim", "args": {"predicate": "buyer_type", "value": "wholesaler", "stance": "supports", "evidence": "e1", "company": "Zenith Textiles"}}, {"name": "propose_claim", "args": {"predicate": "size_band", "value": "large", "stance": "supports", "evidence": "e1"}}]}, {"calls": [], "final": true}], "expect": {"evidence": 1, "claims": 1, "claim_values": ["size_band=large"], "min_refused": 2, "never_shown": ["98765", "manager@sister.test"]}}
{"id": "W09-robots-disallow", "layer": "runner", "title": "a site whose robots.txt disallows everything", "host": "locked.test", "script": [{"calls": [{"name": "fetch_page", "args": {"path": "/"}}]}, {"calls": [{"name": "record_evidence", "args": {"page": "p1", "quote": "This page must never be fetched: the site disallows crawlers."}}, {"name": "propose_claim", "args": {"predicate": "operating_status", "value": "active", "stance": "supports", "evidence": "e1"}}]}, {"calls": [], "final": true}], "expect": {"evidence": 0, "claims": 0, "min_refused": 2, "failed_fetches": 1, "fetched": []}}
