# The Next.js web app (T006b M2, ADR 0015). Build from the REPOSITORY ROOT:
#   docker build -f deploy/Dockerfile.web -t sme-web \
#     --build-arg NEXT_PUBLIC_API_BASE_URL=https://<api> --build-arg NEXT_PUBLIC_SUPABASE_URL=https://<ref>.supabase.co \
#     --build-arg NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<public publishable key> .   (the legacy NEXT_PUBLIC_SUPABASE_ANON_KEY is still accepted)
# The three NEXT_PUBLIC_ values are PUBLIC by design (they reach the browser) and are fixed at BUILD time. No server secret exists for the web app.
FROM node:22-slim AS build
WORKDIR /repo
COPY packages/contracts ./packages/contracts
COPY apps/web/package.json apps/web/package-lock.json ./apps/web/
RUN cd apps/web && npm ci
COPY apps/web ./apps/web
ARG NEXT_PUBLIC_API_BASE_URL
ARG NEXT_PUBLIC_SUPABASE_URL
ARG NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY
ARG NEXT_PUBLIC_SUPABASE_ANON_KEY
ENV NEXT_PUBLIC_API_BASE_URL=$NEXT_PUBLIC_API_BASE_URL \
    NEXT_PUBLIC_SUPABASE_URL=$NEXT_PUBLIC_SUPABASE_URL \
    NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=$NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY \
    NEXT_PUBLIC_SUPABASE_ANON_KEY=$NEXT_PUBLIC_SUPABASE_ANON_KEY \
    NEXT_TELEMETRY_DISABLED=1
RUN cd apps/web && npm run build

FROM node:22-slim
ENV NODE_ENV=production NEXT_TELEMETRY_DISABLED=1 PORT=8080
WORKDIR /repo
COPY --from=build /repo /repo
WORKDIR /repo/apps/web
USER node
EXPOSE 8080
CMD ["sh", "-c", "exec npx next start -p ${PORT} -H 0.0.0.0"]
