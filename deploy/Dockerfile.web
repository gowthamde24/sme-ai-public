# The Next.js web app (T006b M2, ADR 0015; job DE: standalone output). Build from the REPOSITORY ROOT:
#   docker build -f deploy/Dockerfile.web -t sme-web \
#     --build-arg NEXT_PUBLIC_API_BASE_URL=https://<api> --build-arg NEXT_PUBLIC_SUPABASE_URL=https://<ref>.supabase.co \
#     --build-arg NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<public publishable key> --build-arg NEXT_PUBLIC_SITE_URL=https://<the web address> .   (the legacy NEXT_PUBLIC_SUPABASE_ANON_KEY is still accepted)
# The NEXT_PUBLIC_ values are PUBLIC by design (they reach the browser) and are fixed at BUILD time (changing one means building again). No server secret exists for the web app.
# NEXT_PUBLIC_SITE_URL is the address the pages are served from (sitemap, share pictures); without it the build says http://localhost:3000. NEXT_PUBLIC_SITE_LIVE=1 is the launch switch (until then every page says noindex).
FROM node:22-slim AS build
WORKDIR /repo
COPY packages/contracts ./packages/contracts
# job CM: the public paver calculator imports the very calculator the app uses (packages/quote-engine/ts); the landing blocks it reads are generated into apps/web/lib/site (make site-packs)
COPY packages/quote-engine/ts ./packages/quote-engine/ts
COPY apps/web/package.json apps/web/package-lock.json ./apps/web/
RUN cd apps/web && npm ci
COPY apps/web ./apps/web
ARG NEXT_PUBLIC_API_BASE_URL
ARG NEXT_PUBLIC_SUPABASE_URL
ARG NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY
ARG NEXT_PUBLIC_SUPABASE_ANON_KEY
ARG NEXT_PUBLIC_SITE_URL
ARG NEXT_PUBLIC_SITE_LIVE
ENV NEXT_PUBLIC_SITE_URL=$NEXT_PUBLIC_SITE_URL \
    NEXT_PUBLIC_SITE_LIVE=$NEXT_PUBLIC_SITE_LIVE
# job DE: a standalone build (apps/web/next.config.ts): the server and only the files it traces, for a small image and a short cold start
ENV NEXT_OUTPUT=standalone
ENV NEXT_PUBLIC_API_BASE_URL=$NEXT_PUBLIC_API_BASE_URL \
    NEXT_PUBLIC_SUPABASE_URL=$NEXT_PUBLIC_SUPABASE_URL \
    NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=$NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY \
    NEXT_PUBLIC_SUPABASE_ANON_KEY=$NEXT_PUBLIC_SUPABASE_ANON_KEY \
    NEXT_TELEMETRY_DISABLED=1
# `next build` type-checks every .ts file under apps/web, and a few tests import files from /e2e, which is not (and should not be) in the image: the tests are not part of the running app, so they are removed first, with the two test-only support files (apps/web/test and lib/packs/pack-test-kit.ts, which imports /e2e).
RUN cd apps/web && find . -type f -not -path './node_modules/*' \( -name '*.test.ts' -o -name '*.test.tsx' -o -name '*.test.mts' \) -delete && rm -rf test lib/packs/pack-test-kit.ts && npm run build

FROM node:22-slim
ENV NODE_ENV=production NEXT_TELEMETRY_DISABLED=1 PORT=8080 HOSTNAME=0.0.0.0
WORKDIR /app
# The traced server (with its own node_modules), then the two folders a standalone build leaves for the CDN to serve: the fingerprinted static files and public/. The monorepo layout is kept (tracing root = the repository),
# so the server is apps/web/server.js. No development package, no source, no build cache, no npm in the way.
COPY --from=build /repo/apps/web/.next/standalone ./
COPY --from=build /repo/apps/web/.next/static ./apps/web/.next/static
COPY --from=build /repo/apps/web/public ./apps/web/public
USER node
EXPOSE 8080
# `exec node` makes the server process 1, so Cloud Run's SIGTERM reaches it and it stops cleanly. HOSTNAME=0.0.0.0 matters: Docker otherwise sets HOSTNAME to the container's id and the server would listen on that name only.
# The page /login needs no sign-in and no API: it is the web's "is it up" address (scripts/hosted_smoke.py). The Host header the browser sent must reach this process unchanged (docs/adr/0072, "the Host header question").
CMD ["node", "apps/web/server.js"]
