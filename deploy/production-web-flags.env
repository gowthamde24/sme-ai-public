# The feature flags of the PRODUCTION web service (sme-web in the production project), one KEY=VALUE per line. Applied by `deploy/production.sh deploy web` on every deploy.
# EMPTY ON PURPOSE (C1, 11 Nov 2026): the web lane (C2) decides which screens production shows and fills this file in a reviewed PR. Every screen flag that is not listed stays off or mock.
# Not a secret: flags only. Never copy the staging file wholesale (it lists the owner's three TEST workspace ids and mock/real switches that are staging decisions).
# Owner, 20 Nov 2026 (Customer Zero): Telugu, Hindi and Kannada show a string only where a person marked it reviewed; English otherwise. UNSET on staging (the owner reads the drafts there).
# Owner decision 19 Nov 2026 (decision-ai-team), prepared 23 Nov 2026 by C2 for Customer Zero: the Jobs screens (Today's jobs, the job pages, the job builder) read C1's real routes (the API has JOBS=on in deploy/settings/production/api.env). Never PREVIEW_JOBS here (staging only: a cookie that turns screens on with sample data), and none of the staging file's workspace ids.
# 25 Nov 2026 (C2, owner: Customer Zero must see the staging look): the screens a shop owner uses, every one `=1` = the REAL API. Never here: PREVIEW_JOBS, any `mock` value, a workspace id, the demo / test-call / staff / developer / offer / draft-legal flags, paid billing (EARLY_ACCESS=1 hides billing). The plan and the reason for every flag in or out: reports/prod-web-flags-plan.md; lib/screens/preview-deploy.test.ts guards the rules.
REVIEWED_TRANSLATIONS_ONLY=1
JOBS=1
EARLY_ACCESS=1
DESIGN_V6=1
APP_V4=1
TODAY_V5=1
TODAY_SUMMARY_SCREENS=1
BOOTSTRAP=1
REQUEST_MEMO=1
ASSISTANT_SCREENS=1
ASSISTANT_STATUS=1
ACTIVITY_SCREENS=1
AI_TEAM_SCREENS=1
ABOUT_BUSINESS_SCREENS=1
TALK_TRAINING_SCREENS=1
SPEAKS_PANEL_SCREENS=1
OPENING_LINE_SCREENS=1
PRONUNCIATION_SCREENS=1
TEACH_SCREENS=1
VOICE_PICKER_SCREENS=1
VOICE_SAMPLE_SCREENS=1
BROWSER_VOICE=1
CALL_SCREENS=1
CALL_SETTINGS_SCREENS=1
CALL_LIMIT_SCREENS=1
OUTCOME_SCREENS=1
LEADS_SCREENS=1
OUTREACH_SCREENS=1
SOURCE_CARDS_SCREENS=1
TASK_SCREENS=1
CHAT_QUEUE_SCREENS=1
CHAT_ASSISTANT_SWITCH=1
OUTBOX_WHATSAPP=1
PHONE_NUMBER_SCREENS=1
DPDP_SCREENS=1
# 25 Nov 2026 (C2, planner: merged AND verified on staging; the production API has the migrations 988000/988100 and rev 3): the open-look screens and the first-run type. Real data only; none of these is a mock.
FIRST_RUN_TYPE=1
FIRST_DAY_OPEN=1
TODAY_OPEN=1
SETTINGS_OPEN=1
TEMPLATES_PLAIN=1
MY_ASSISTANT_OPEN=1
# 25 Nov 2026 (C2): Calls as a list, Leads as open rows, Reports as one calm page (seen on staging, tag a769a9b2 + a follow-up).
CALLS_OPEN=1
LEADS_OPEN=1
REPORTS_OPEN=1
# 25 Nov 2026 (C2): filter bars without sentences on Calls, Leads, Reports and Catalogue (seen on staging, tag c3e4ab8d).
FILTERS_OPEN=1
# 29 Nov 2026 (C2): the owner-only "Place a test call" (Phone calls ?test=1). Outbound calling is on in production in SANDBOX mode: the page offers only the API's masked sandbox list (it sends an id, never a number) and the API's gate refuses any number not on that list (not_on_sandbox_list). TEST_CALL_TONE stays off.
TEST_CALL_SCREENS=1
# 26 Nov 2026 (release 2, planner: conservative): the assistant that does the work (every workspace: only the owner's two real workspaces exist in production; ASSISTANT_WORK_TENANTS stays unset), describe-the-job (Tell), the industry pages, and the Turnstile check box (its API route POST /v1/public/turnstile/verify is in this release; the API gets CAPTCHA_PROVIDER=turnstile + CAPTCHA_SECRET in the same deploy). NOT here: CALLS_PANEL (its card carries billing text while BILLING_CHARGE_CALLS is off), LEGAL_DRAFT_PAGES (AUP and refunds not approved), billing / top-up / KYC / number picker / extra-lines screens.
ASSISTANT_WORK_SCREENS=1
TELL_SCREENS=1
INDUSTRY_PAGES=1
TURNSTILE_SITE_KEY=0x4AAAAAAGSTVtE7D8SGjLEZ
# 26 Nov 2026 (owner, release 4): AI employees (AI Team) and the owner's own What you sell lists are on in production; the API flags EMPLOYEES and WHAT_YOU_SELL_LISTS are true in production api.env, EMPLOYEES in worker.env.
EMPLOYEES=1
WHAT_YOU_SELL_LISTS=1
