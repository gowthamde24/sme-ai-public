# Names only. NEVER put a real secret in this file or commit one (job BG, docs/runbooks/hosting-owner-runbook.md). EVERY setting of the API, the worker and the web, with its kind, is in docs/runbooks/hosting-env-and-secrets.md.
# Copy the PUBLIC lines you need into your shell for one run of deploy/cloudrun.sh; secrets are never exported like this: they live in Secret Manager (deploy/cloudrun.sh secrets) and reach the service as secret references.
#
# Legend:  [public]  safe to see; it also reaches the browser or is in the project settings
#          [secret]  server-side only; Secret Manager, typed HIDDEN, never in a file, a chat or a command line
#          [owner]   a value only the owner can obtain (an account step)

# ---- every deploy script -----------------------------------------------------------------------------------------------------------------------------------------------
PROJECT_ID=                       # [owner] the Google Cloud project id (Cloud Run, Artifact Registry, Secret Manager, Cloud Scheduler)
REGION=asia-south1                # Mumbai. Cloud Run Tier 1 pricing there. Keep it equal to the Supabase region (ap-south-1, Mumbai).
SUPABASE_URL=                     # [public] https://<project ref>.supabase.co  (Supabase > Project settings > API)
SUPABASE_PUBLISHABLE_KEY=         # [public] the publishable (formerly anon) key. NOT the secret key, NOT the service-role key: nothing here uses either.
WEB_ORIGIN=                       # [public] the web address the browser uses (https). It becomes the API's CORS origin.
API_URL=                          # [public] the API's address (https); needed to build the web image

# ---- the API (deploy/cloudrun.sh api) ----------------------------------------------------------------------------------------------------------------------------------
# set by the script from the values above: API_ENV=production, API_CORS_ORIGINS, SUPABASE_JWT_ISSUER (<url>/auth/v1), SUPABASE_JWT_AUDIENCE=authenticated, SUPABASE_JWKS_URL, SUPABASE_JWT_ALGORITHMS=ES256, AGENTS_ENABLED
AGENTS_ENABLED=false              # [public] true only together with CPU_ALWAYS=true (about USD 44 a month); see the runbook
CPU_ALWAYS=false
TRUSTED_PROXY_HOPS=                # [public] (default 1) how many proxies write X-Forwarded-For before the API: 1 = Cloud Run itself; more behind Cloudflare or a load balancer (measure it in the rehearsal)
MAIL_FROM=                        # [public] (job DB) the address app e-mails are sent from, e.g. noreply@stack19.com (Supabase Auth SMTP sender); never a personal address
VAPID_SUBJECT=                    # [public] mailto: plus the business's support address (apps/web/lib/site/business.ts), only when web-push is on
RUN_SA=                           # [owner] the service account the services run as (docs/runbooks/hosting-rehearsal-owner.md Part 4); give it ONLY roles/secretmanager.secretAccessor on the secrets below
# [secret] SUPPRESSION_HMAC_KEY   Secret Manager secret "sme-suppression-hmac-key" (generated and stored by `deploy/cloudrun.sh secrets`; the API refuses to start without it)
# [secret] only when agents are on, one model provider (ADR 0013): the key of the provider you chose, as a secret reference, e.g.
#   EXTRA_SECRETS=ANTHROPIC_API_KEY=sme-anthropic-api-key:latest      (create that secret yourself with `gcloud secrets create`, value from stdin; plus LLM_PROVIDER, LLM_MODEL, the two prices and LLM_SPEND_CAP_CONFIRMED=true as plain env vars after the PROVIDER-SIDE hard cap exists)

# ---- the web (deploy/cloudrun.sh web) ----------------------------------------------------------------------------------------------------------------------------------
# NEXT_PUBLIC_API_BASE_URL, NEXT_PUBLIC_SUPABASE_URL, NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY and NEXT_PUBLIC_SITE_URL are baked in at BUILD time from API_URL, SUPABASE_URL, SUPABASE_PUBLISHABLE_KEY and WEB_ORIGIN. All are public by design.
SITE_LIVE=                        # [public] (default 0) the launch switch (NEXT_PUBLIC_SITE_LIVE): 0 until the public launch, so every page says noindex
# The web has no server secret. (Changing a value means building the image again.)

# ---- the scheduler worker (deploy/cloudrun.sh worker) ------------------------------------------------------------------------------------------------------------------
SCHEDULER_EMAIL=                  # [owner] the e-mail of the scheduler's own account, registered by the operator (docs/runbooks/scheduler-local.md; ADR 0068)
SCHEDULER_SA=                     # [owner] the service account e-mail Cloud Scheduler uses to start the job (needs roles/run.invoker on the job)
WORKER_EVERY_MINUTES=              # [public] (default 5) 1 to 59: how often Cloud Scheduler starts the worker (India time) AND the worker's own interval (SCHEDULER_INTERVAL_SECONDS = this x 60, set by the script). They must agree: the status card calls the worker running while its last tick is under three intervals old
# [secret] SCHEDULER_PASSWORD     Secret Manager secret "sme-scheduler-password" (typed hidden by `deploy/cloudrun.sh secrets`)
# OUTBOX_ADAPTER=fake is set by the script: no real channel exists yet (the owner sends from the phone with the WhatsApp link), so the worker sends nothing to anyone.

# ---- the backup (deploy/backup-db.sh) ------------------------------------------------------------------------------------------------------------------------------------
BACKUP_DB_HOST=                   # [owner] from Supabase > Connect (the session pooler host if you have no IPv6)
BACKUP_DB_USER=                   # [owner] postgres.<project ref> for the pooler
# the database password is typed hidden when the script runs; it is never an environment variable you set.

# ---- verification (scripts/verify_hosted.py, read-only) -----------------------------------------------------------------------------------------------------------------
# HOSTED_SUPABASE_URL, HOSTED_SUPABASE_PUBLISHABLE_KEY, HOSTED_API_URL, HOSTED_WEB_ORIGIN [public]; HOSTED_DATABASE_URL is optional and contains the database password: type it into the shell for one run, never save it.
