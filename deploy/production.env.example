# PUBLIC values of the PRODUCTION stack (copy to deploy/.env.production, which git ignores; fill after the owner created the two projects). Nothing here is a secret.
# deploy/production.sh refuses to run if any of these is missing, a placeholder, or equal to a STAGING value.
PROD_PROJECT_ID=
PROD_PROJECT_NUMBER=
PROD_SUPABASE_REF=
# The address the web is served from (Cloudflare Worker in front of the run.app address, as staging does; no Google load balancer). Calls and Plivo callbacks use the API's run.app address, never this one.
PROD_WEB_ORIGIN=https://app.stack19.com
PROD_MAIL_DOMAIN=stack19.com
# The waitlist slice (docs/runbooks/production-waitlist-slice.md): set PROD_SLICE=waitlist in the shell for each production.sh call (or here). Optional: the public site's address, added to the API's CORS fence.
# PROD_SLICE=waitlist
# PROD_SITE_ORIGIN=https://stack19.com
# The scheduler account of the production project (the worker signs in as it); the owner registers it in step 2 of the owner list.
PROD_SCHEDULER_EMAIL=
