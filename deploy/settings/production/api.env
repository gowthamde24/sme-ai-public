# Declared settings of the PRODUCTION API, full stack (deploy/production.sh without PROD_SLICE). Plain values, public only. Written 12 Nov 2026 from what production.sh composed before; NOT yet applied anywhere.
# A change is a pull request to THIS file; a deploy stops on any difference from the serving revision that ALLOW_FLAG_CHANGE does not name (e.g. ALLOW_FLAG_CHANGE=TELEPHONY_MODE for the go-live).
# @env:NAME = read from the deploy's environment (deploy/production.sh exports them from deploy/.env.production and the Supabase project): public ids and addresses only.
API_ENV=production
LOG_FORMAT=json
AGENTS_ENABLED=true
AGENTS_MAX_WORKERS=1
AGENTS_MAX_QUEUE=4
SUPABASE_URL=@env:SUPABASE_URL
SUPABASE_PUBLISHABLE_KEY=@env:SUPABASE_PUBLISHABLE_KEY
SUPABASE_JWT_ISSUER=@env:SUPABASE_JWT_ISSUER
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_JWKS_URL=@env:SUPABASE_JWKS_URL
SUPABASE_JWT_ALGORITHMS=ES256
API_CORS_ORIGINS=@env:API_CORS_ORIGINS
PRIVACY_EMAIL=@env:PRIVACY_EMAIL
HELLO_EMAIL=@env:HELLO_EMAIL
PRIVACY_VERSION=@env:PRIVACY_VERSION
TERMS_VERSION=2026-10-27
TRUSTED_PROXY_HOPS=1
BILLING_EMAIL_SENDER=resend
MAIL_FROM=@env:MAIL_FROM
MAIL_REPLY_TO=@env:MAIL_REPLY_TO
WORKSPACE_SECRETS=gcp
WORKSPACE_SECRETS_PROJECT=@env:PROJECT_ID
BROWSER_VOICE_ENABLED=true
BROWSER_VOICE_SPEAKER_CHECK=shadow
BROWSER_VOICE_DAY_SECONDS=3600
LLM_PROVIDER=anthropic
LLM_MODEL=claude-haiku-5-5
LLM_INPUT_MICROS_PER_MTOK=9000000
LLM_OUTPUT_MICROS_PER_MTOK=45000000
LLM_SPEND_CAP_CONFIRMED=true
SPEECH_PROVIDER=sarvam
PAGE_MAX_INFLIGHT=12
PAGE_READ_CACHE_S=3
PAGE_QUEUE_WAIT_S=1.0
PAGE_QUEUE_MAX=60
MEMBERSHIP_CACHE_S=15
POLICY_CACHE_S=60
# TELEPHONY: `sandbox` (only the numbers in the secret sme-telephony-sandbox-numbers may call in) until the owner has opened the real-data gate AND written "live"; then this line changes in a reviewed PR,
# the deploy runs with ALLOW_FLAG_CHANGE=TELEPHONY_MODE and PROD_LIVE_OK=yes (customer-zero-go-live-checklist.md). Outbound stays false and the Lead Desk dialer stays OFF (empty) until the owner says otherwise.
TELEPHONY_MODE=sandbox
TELEPHONY_OUTBOUND=false
TASKS_DIALER=
TELEPHONY_MAX_CONCURRENT=2
TELEPHONY_COST_PAISE_PER_MINUTE=38
TELEPHONY_COST_PULSE_S=30
TELEPHONY_MAX_CALL_S=300
TELEPHONY_INBOUND_LANGUAGE=te
SCHEDULER_EMAIL=@env:SCHEDULER_EMAIL
PUBLIC_BASE_URL=@env:API_URL
