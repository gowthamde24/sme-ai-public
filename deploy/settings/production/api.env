# Declared settings of the PRODUCTION API, full stack (deploy/production.sh without PROD_SLICE). Plain values, public only. Written 12 Nov 2026 from what production.sh composed before; NOT yet applied anywhere.
# A change is a pull request to THIS file; a deploy stops on any difference from the serving revision that ALLOW_FLAG_CHANGE does not name (e.g. ALLOW_FLAG_CHANGE=TELEPHONY_MODE for the go-live).
# @env:NAME = read from the deploy's environment (deploy/production.sh exports them from deploy/.env.production and the Supabase project): public ids and addresses only.
API_ENV=production
LOG_FORMAT=json
AGENTS_ENABLED=true
AGENTS_MAX_WORKERS=1
AGENTS_MAX_QUEUE=4
SUPABASE_URL=@env:SUPABASE_URL
SUPABASE_PUBLISHABLE_KEY=@env:SUPABASE_PUBLISHABLE_KEY
SUPABASE_JWT_ISSUER=@env:SUPABASE_JWT_ISSUER
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_JWKS_URL=@env:SUPABASE_JWKS_URL
SUPABASE_JWT_ALGORITHMS=ES256
API_CORS_ORIGINS=@env:API_CORS_ORIGINS
PRIVACY_EMAIL=@env:PRIVACY_EMAIL
HELLO_EMAIL=@env:HELLO_EMAIL
PRIVACY_VERSION=2026-11-26
TERMS_VERSION=2026-11-26
TRUSTED_PROXY_HOPS=1
BILLING_EMAIL_SENDER=resend
MAIL_FROM=@env:MAIL_FROM
MAIL_REPLY_TO=@env:MAIL_REPLY_TO
WORKSPACE_SECRETS=gcp
WORKSPACE_SECRETS_PROJECT=@env:PROJECT_ID
BROWSER_VOICE_ENABLED=true
BROWSER_VOICE_SPEAKER_CHECK=shadow
BROWSER_VOICE_DAY_SECONDS=3600
LLM_PROVIDER=anthropic
LLM_MODEL=claude-haiku-5-5
LLM_INPUT_MICROS_PER_MTOK=9000000
LLM_OUTPUT_MICROS_PER_MTOK=45000000
LLM_SPEND_CAP_CONFIRMED=true
SPEECH_PROVIDER=sarvam
PAGE_MAX_INFLIGHT=12
PAGE_READ_CACHE_S=3
PAGE_QUEUE_WAIT_S=1.0
PAGE_QUEUE_MAX=60
MEMBERSHIP_CACHE_S=15
POLICY_CACHE_S=60
# TELEPHONY: `sandbox` (only the numbers in the secret sme-telephony-sandbox-numbers may call in) until the owner has opened the real-data gate AND written "live"; then this line changes in a reviewed PR,
# the deploy runs with ALLOW_FLAG_CHANGE=TELEPHONY_MODE and PROD_LIVE_OK=yes (docs-private/runbooks/customer-zero-go-live-checklist.md). Outbound stays false and the Lead Desk dialer stays OFF (empty) until the owner says otherwise.
TELEPHONY_MODE=sandbox
# OUTBOUND ON, STILL FENCED (28 Nov 2026): TELEPHONY_MODE stays sandbox, so the gate refuses every number that is not on the sandbox list (3 numbers: the owner, his mother, his brother) with not_on_sandbox_list; only the Owner's "place a test call" exists (TASKS_DIALER is empty: no task dials anyone). `live` needs the owner's written word.
TELEPHONY_OUTBOUND=true
# VOICELINK_RECORDING_EXPECTED stays unset (false) until the owner-approved privacy text, the notice lines and the notice in the caller's language are live: then the planner deploys it with ALLOW_FLAG_CHANGE=VOICELINK_RECORDING_EXPECTED.
# The phone's speaking model (28 Nov 2026, first real call: the model's first token was 600-900 ms of a 1.1-1.5 s wait). Sarvam 105B answers in ~316 ms (Haiku 652, same prompt, 22 turns, staging keys, 0 failures); if it sends no first piece within TELEPHONY_FIRST_TOKEN_MS the same turn goes to Haiku at once (docs/runbooks/phone-model.md). Back to Haiku: TELEPHONY_LLM=haiku.
TELEPHONY_LLM=sarvam
TELEPHONY_FIRST_TOKEN_MS=700
TASKS_DIALER=
# Two channels since 28 Nov 2026 (the owner bought the second): two calls at once.
TELEPHONY_MAX_CONCURRENT=2
TELEPHONY_COST_PAISE_PER_MINUTE=50
TELEPHONY_COST_PAISE_PER_MINUTE_INBOUND=25
TELEPHONY_COST_PULSE_S=60
TELEPHONY_MAX_CALL_S=300
TELEPHONY_INBOUND_LANGUAGE=te
SCHEDULER_EMAIL=@env:SCHEDULER_EMAIL
PUBLIC_BASE_URL=@env:API_URL
# Lead Finder in production (planner and owner, 20 Nov 2026; customer-zero-plan.md section 3): OFF until the production Google Places key exists AND the web's no-cache test is merged. NEVER `fixture` here: a real shop would
# be shown invented businesses. To switch it on: LEAD_FINDER=places, GOOGLE_PLACES_API_KEY=sme-google-places-api-key in api.secrets, then ALLOW_FLAG_CHANGE=LEAD_FINDER,GOOGLE_PLACES_API_KEY. The free monthly caps of the Google
# SKUs (ops_google_budget, google_allowed in app/lead_finder/service.py) stop every search and every details fetch past the free allowance: nothing is billed without the owner's OK.
LEAD_FINDER=off
# The Jobs routes (20 Nov 2026, owner: "turn on jobs also"): routes only, nothing starts by itself; the web screens come with the web flag in deploy/production-web-flags.env (C2).
JOBS=on
# Google sign-in (owner, 21 Nov 2026): the PUBLIC client id of the OAuth client in stack19-production (redirect https://ijmsusgyilwskpjxfauu.supabase.co/auth/v1/callback); the secret lives only in Supabase. Nothing is deployed until the owner says go (docs-private/runbooks/production-bringup-all-in-order.md).
AUTH_GOOGLE_CLIENT_ID=488341211094-6a7hdpehgso0cvimftu28aogs8psamu3.apps.googleusercontent.com
# VoiceLink is the only telephony provider (owner, 24 Nov 2026): outbound call-backs, the wallet read and the number list use its login (secrets below); the bot's address token is VOICELINK_WS_TOKEN.
# The cost per minute above is VoiceLink's: Rs 0.50 per 60-second pulse outbound (Rs 0.25 inbound; the dearer one is the one the usage ledger assumes).
TELEPHONY_PROVIDER=voicelink
# "I sent it" for a message the owner sent by hand from their own WhatsApp (the web "Open in WhatsApp" button, OUTBOX_WHATSAPP=1 in web.env). This system sends nothing; it records the owner's word (owner, 28 Nov 2026).
OUTBOX_WHATSAPP=true
# Outbound webhooks (connectors plan C1 item 2, docs/contracts/webhooks-out.md): WEBHOOKS_OUT stays UNSET (= off) until the owner's gate. Unset: the routes answer 404 and the worker sends nothing. To switch it on: WEBHOOKS_OUT=on here; in worker.env WEBHOOKS_OUT=on, WORKSPACE_SECRETS=gcp and WORKSPACE_SECRETS_PROJECT (the signing secrets live in Secret Manager as sme-ws-*; the worker's service account must read them, as for Google Calendar); then ALLOW_FLAG_CHANGE=WEBHOOKS_OUT.
# A Razorpay LIVE key (rzp_live_...) stops the API at start unless this says true. OFF until the owner decides live payments may begin (credits top-up, 24 Nov 2026); a change is a pull request and ALLOW_FLAG_CHANGE=RAZORPAY_LIVE_OK at the deploy.
RAZORPAY_LIVE_OK=false
# The public "Talk to us" form (release 2, 26 Nov 2026, docs/contracts/contact-form.md): the route answers instead of 404; per-address and per-contact limits apply. The Turnstile check box is checked ONCE, by POST /v1/public/turnstile/verify (docs/contracts/dpdp.md); the secret is CAPTCHA_SECRET in api.secrets and the web has TURNSTILE_SITE_KEY. Without both the contact form is spam-exposed, so they go together.
CONTACT_FORM=true
CAPTCHA_PROVIDER=turnstile
# Owner, 26 Nov 2026: Cartesia SPONSORS the voice and nobody may hear another voice than the one they chose (no fallback voices). Live talk with the owner speaks with the chosen voice's own engine; the daily cap lives in public.voice_budget (migration 992740: 1.5 million characters a day, 30,000 a call, a hard ceiling only).
VOICE_TALK_PRIMARY=true
# 26 Nov 2026 (owner, release 5): AI employees answer in production (only the owner's own workspaces exist; sign-up is closed). The WORKER has the same flag (the WhatsApp auto-reply reads it).
EMPLOYEES=true
