# Secret Manager references: NAME=secret-name[:version]. The value is never in git; the owner creates each one at a hidden prompt (docs/runbooks/production-owner-steps.md).
# The shop's own mobile numbers (TELEPHONY_SHOP_NUMBERS=sme-telephony-shop-numbers) are added here, in a reviewed PR, when the secret exists (caller guard, app/telephony/caller_guard.py).
ANTHROPIC_API_KEY=sme-anthropic-api-key
CARTESIA_API_KEY=sme-cartesia-api-key
EXOTEL_STREAM_SECRET=sme-exotel-stream-secret
PLIVO_AUTH_ID=sme-plivo-auth-id
PLIVO_AUTH_TOKEN=sme-plivo-auth-token
RESEND_API_KEY=sme-resend-api-key
SARVAM_API_KEY=sme-sarvam-api-key
SCHEDULER_PASSWORD=sme-scheduler-password
SUPPRESSION_HMAC_KEY=sme-suppression-hmac-key
TELEPHONY_SANDBOX_NUMBERS=sme-telephony-sandbox-numbers
