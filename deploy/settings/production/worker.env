# Declared settings of the job sme-worker (production). Public values only; NAME=@ignore means present but not for git; secret:SECRET:KEY is a Secret Manager reference. Edit in a pull request; `python3 deploy/drift.py check` finds a hand edit.
API_ENV=production
BILLING_EMAIL_SENDER=resend
EMPLOYEES=true
HELLO_EMAIL=hello@stack19.com
LOG_FORMAT=json
MAIL_FROM=noreply@stack19.com
MAIL_REPLY_TO=support@stack19.com
OUTBOX_ADAPTER=fake
OUTREACH_DIALER=fake
PLIVO_BALANCE_CHECK=true
PLIVO_BALANCE_CURRENCY=INR
PLIVO_BALANCE_MIN_INR=500
PRIVACY_EMAIL=privacy@stack19.com
RESEND_API_KEY=secret:sme-resend-api-key:latest
SARVAM_API_KEY=secret:sme-sarvam-api-key:latest
SCHEDULER_EMAIL=scheduler@stack19.com
SCHEDULER_INTERVAL_SECONDS=60
SCHEDULER_PASSWORD=secret:sme-scheduler-password:latest
SPEECH_PROVIDER=sarvam
SUPABASE_JWKS_URL=https://ijmsusgyilwskpjxfauu.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_JWT_ALGORITHMS=ES256
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_JWT_ISSUER=https://ijmsusgyilwskpjxfauu.supabase.co/auth/v1
SUPABASE_PUBLISHABLE_KEY=@ignore
SUPABASE_URL=https://ijmsusgyilwskpjxfauu.supabase.co
SUPPRESSION_HMAC_KEY=secret:sme-suppression-hmac-key:latest
TELEPHONY_MAX_CALL_S=300
TELEPHONY_PROVIDER=voicelink
VOICELINK_PASSWORD=secret:sme-voicelink-password:latest
VOICELINK_USERNAME=secret:sme-voicelink-username:latest
