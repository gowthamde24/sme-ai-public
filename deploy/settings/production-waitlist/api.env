# Declared settings of the PRODUCTION API, waitlist slice (PROD_SLICE=waitlist; docs/runbooks/production-waitlist-slice.md). Plain values, public only. Written 12 Nov 2026; NOT yet applied anywhere.
# The slice: agents off, telephony off, no WhatsApp, no LLM, scale to zero. Growing it into the full stack is a named change (ALLOW_FLAG_CHANGE=NAME,...) on a later deploy, never a rebuild.
# @env:NAME = read from the deploy's environment (deploy/production.sh exports them from deploy/.env.production and the Supabase project): public ids and addresses only.
API_ENV=production
LOG_FORMAT=json
AGENTS_ENABLED=false
TELEPHONY_MODE=off
TELEPHONY_OUTBOUND=false
TASKS_DIALER=
BROWSER_VOICE_ENABLED=false
CAPTCHA_PROVIDER=turnstile
SUPABASE_URL=@env:SUPABASE_URL
SUPABASE_PUBLISHABLE_KEY=@env:SUPABASE_PUBLISHABLE_KEY
SUPABASE_JWT_ISSUER=@env:SUPABASE_JWT_ISSUER
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_JWKS_URL=@env:SUPABASE_JWKS_URL
SUPABASE_JWT_ALGORITHMS=ES256
API_CORS_ORIGINS=@env:API_CORS_ORIGINS
PRIVACY_EMAIL=@env:PRIVACY_EMAIL
HELLO_EMAIL=@env:HELLO_EMAIL
PRIVACY_VERSION=@env:PRIVACY_VERSION
TERMS_VERSION=2026-10-27
TRUSTED_PROXY_HOPS=1
PAGE_MAX_INFLIGHT=12
PAGE_READ_CACHE_S=3
PAGE_QUEUE_WAIT_S=1.0
PAGE_QUEUE_MAX=60
MEMBERSHIP_CACHE_S=15
POLICY_CACHE_S=60
