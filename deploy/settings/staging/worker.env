# Declared settings of the job sme-worker (staging). Public values only; NAME=@ignore means present but not for git; secret:SECRET:KEY is a Secret Manager reference. Edit in a pull request; `python3 deploy/drift.py check` finds a hand edit.
ANTHROPIC_API_KEY=secret:sme-anthropic-api-key:latest
API_ENV=production
AUTO_REPLY_ENABLED=true
AUTO_REPLY_MODEL=claude-haiku-5-5
BILLING_EMAIL_SENDER=resend
HELLO_EMAIL=hello@stack19.com
LOG_FORMAT=json
MAIL_FROM=noreply@stack19.com
MAIL_REPLY_TO=support@stack19.com
OUTBOX_ADAPTER=whatsapp
OUTREACH_DIALER=fake
PRIVACY_EMAIL=privacy@stack19.com
RESEND_API_KEY=secret:sme-resend-api-key:latest
SARVAM_API_KEY=secret:sme-sarvam-api-key:latest
SARVAM_TTS_MODEL=bulbul:v4-flash
SCHEDULER_EMAIL=scheduler@demo.example.test
SCHEDULER_INTERVAL_SECONDS=60
SCHEDULER_PASSWORD=secret:sme-scheduler-password:latest
SPEECH_PROVIDER=sarvam
SUPABASE_JWKS_URL=https://uiallwgywitryxatcqxf.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_JWT_ALGORITHMS=ES256
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_JWT_ISSUER=https://uiallwgywitryxatcqxf.supabase.co/auth/v1
SUPABASE_PUBLISHABLE_KEY=@ignore
SUPABASE_URL=https://uiallwgywitryxatcqxf.supabase.co
SUPPRESSION_HMAC_KEY=secret:sme-suppression-hmac-key:latest
TELEPHONY_MAX_CALL_S=180
TEMPLATE_SYNC=true
TOKEN_EXPIRY_CHECK=true
WHATSAPP_ACCESS_TOKEN=secret:sme-whatsapp-token:latest
WHATSAPP_ALLOWED_RECIPIENTS=@ignore
WHATSAPP_GRAPH_VERSION=v25.0
