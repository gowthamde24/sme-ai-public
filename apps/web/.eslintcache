tions, thread.items]",{"range":"12925","text":"12926"},"Cartesia's own SVG, committed to /public/brand, shown as it is (their rule: no resizing tricks)","the white file for dark backgrounds","Update the dependencies array to be: [calm, text, voice.playing]",{"range":"12927","text":"12928"},"the words are fixed for the page","Update the dependencies array to be: [initial]",{"range":"12929","text":"12930"},"ApiRequestError",[429,446],[1101,1104],"unknown",[1101,1104],"never","PackFrame",[405,421],[1368,1384],"[fraction, playing, total]","DictInput",[24,34],[1425,1459],"[known]","PanelIslands",[1711,1724],[5112,5125],"[query, lead, find]",[5926,5936],"[p.actions, p.autoRead, p.leadId, p.thread.items, router]",[1400,1411],"[resetKey, signature]",[8892,8899],"[reset, tellEnded]",[12239,12246],[16014,16060],"[snap?.plan, planBusy, waiting]",[1734,1739],"[closeLabel, key, label, lines, moreHref, moreLabel, screen, supportHref, supportLabel]",[2797,2802],"[actions, active, key]",[2319,2321],"[load, open]","PeriodKey",[441,457],[3967,3976],"[base, card.id, card.note, card.replayed, card.spec, pathname, router]",[7521,7533],"[sendIt, takeFiles, talkAttach]",[2729,2731],"[actions, thread.items]",[6768,6789],"[calm, text, voice.playing]",[2664,2700],"[initial]"]